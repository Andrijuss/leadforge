# Leadforge - configurazione ambiente
# Copia in .env e compila. Mai committare .env.

# == SMTP (Gmail) ==
# Serve una "App password" di Google (2FA obbligatoria):
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=andrijusciric@gmail.com
SMTP_PASS=
SMTP_FROM=andrijusciric@gmail.com

# == Agenzia ==
AGENCY_NAME=Andrijus
AGENCY_TAGLINE=Design, web & automazione AI
AGENCY_WEBSITE=https://andrijus.example.com
AGENCY_EMAIL=andrijusciric@gmail.com
AGENCY_PHONE=
AGENCY_ADDRESS=

# == Browser headless ==
# Set che usa Chromium scaricato da puppeteer. Su server senza root servono le
# librerie di sistema in .local/ (vedi README). LD_LIBRARY_PATH viene impostato
# dagli script automaticamente.
PUPPETEER_LD_LIBRARY_PATH=/opt/leadforge/.local/usr/lib/x86_64-linux-gnu
PUPPETEER_EXECUTABLE_PATH=

# == Default ==
LANG=it
CURRENCY=EUR